{
  "name": "gratis-landing",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview --host 0.0.0.0",
