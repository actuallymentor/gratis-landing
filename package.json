    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@vitejs/plugin-react": "^6.1.1",
    "airier": "^0.1.1",
    "eslint": "^9.39.5",
    "puppeteer": "^25.12.0",
    "vite": "^8.3.1",
    "wrangler": "^4.145.0"
  }
}
